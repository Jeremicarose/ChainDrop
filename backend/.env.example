# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/chaindrop

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Blockchain Configuration
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
ACCOUNT_FACTORY_ADDRESS=0x...
PAYMASTER_ADDRESS=0x...
CLAIM_VERIFIER_ADDRESS=0x...

# Admin Private Key (for contract interactions)
ADMIN_PRIVATE_KEY=your_private_key_here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API Keys (if needed)
# INFURA_API_KEY=
# ALCHEMY_API_KEY=

# AI Configuration (for natural language payments)
# Claude API - Intent parsing (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Crypto.com AI Agent SDK (for hackathon compliance)
CRONOS_EXPLORER_API_KEY=your_cronos_explorer_api_key_here
CRONOS_CHAIN_ID=338

# Optional: OpenAI for full Crypto.com SDK features
# OPENAI_API_KEY=your_openai_api_key_here
