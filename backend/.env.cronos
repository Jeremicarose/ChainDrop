# PRODUCTION - CRONOS EVM CONFIGURATION FOR HACKATHON
# To use: Copy this to .env when deploying for demo

# Server Configuration
PORT=3000
NODE_ENV=production

# Blockchain Configuration - CRONOS EVM
RPC_URL=https://evm.cronos.org
CHAIN_ID=338

# Contract Addresses (TODO: Deploy contracts to Cronos and update these)
