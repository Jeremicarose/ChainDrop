CLAIM_VERIFIER_ADDRESS=0x_TODO_DEPLOY_TO_CRONOS
ENTRY_POINT_ADDRESS=0x_TODO_DEPLOY_TO_CRONOS

# Admin Private Key for Cronos (TODO: Generate new wallet for Cronos)
